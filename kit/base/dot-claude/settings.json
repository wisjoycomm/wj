{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Agent(orca-worker)",
      "Bash(wj plan *)",
      "Bash(wj verify *)",
      "Bash(wj digest *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(jq *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(/PLAN-ARCHIVE.md)"
    ]
  }
}
