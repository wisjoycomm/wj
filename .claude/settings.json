{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v wj >/dev/null 2>&1 && wj guard || true",
            "type": "command"
          }
        ],
        "matcher": "Read|Bash|PowerShell"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(eza *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(gofmt -l *)",
      "Agent(orca-worker)",
      "Bash(orca status)",
      "Bash(orca orchestration worker-start *)",
      "Bash(orca orchestration check *)",
      "Bash(orca orchestration worker-list *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh auth status *)",
      "Bash(gh pr view *)",
      "Bash(gh run list *)",
      "Bash(gh run watch *)",
      "Bash(gh release view *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh auth status *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh run list *)",
      "PowerShell(gh run watch *)",
      "PowerShell(gh release view *)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh gist create *)",
      "PowerShell(gh pr comment *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr edit *)",
      "PowerShell(gh pr close *)",
      "PowerShell(gh issue create *)",
      "PowerShell(gh issue comment *)",
      "PowerShell(gh issue edit *)",
      "PowerShell(gh issue close *)",
      "PowerShell(gh release create *)",
      "PowerShell(gh release edit *)",
      "PowerShell(gh release delete *)",
      "PowerShell(gh gist create *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(/PLAN-ARCHIVE.md)",
      "Read(**/go.sum)",
      "Read(**/vendor/**)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
