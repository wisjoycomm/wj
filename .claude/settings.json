{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "BASH_MAX_OUTPUT_LENGTH": "15000",
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v wj >/dev/null 2>&1 && wj guard || true",
            "type": "command"
          }
        ],
        "matcher": "Read|Bash|PowerShell"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(wj plan *)",
      "Bash(wj verify *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(eza *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(gofmt -l *)",
      "Agent(orca-worker)",
      "Bash(wj digest *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(wj trash *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(/PLAN-ARCHIVE.md)",
      "Read(**/go.sum)",
      "Read(**/vendor/**)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
