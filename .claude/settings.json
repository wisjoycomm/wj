{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_GLOB_NO_IGNORE": "false"
  },
  "permissions": {
    "allow": [
      "Bash(wj plan *)",
      "Bash(wj verify *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(eza *)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(go test *)",
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(gofmt -l *)",
      "Agent(orca-worker)",
      "Bash(wj digest *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(/PLAN-ARCHIVE.md)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
